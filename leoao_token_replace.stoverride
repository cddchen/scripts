#!name=乐刻健身 Token 替换与安全重签
#!desc=自动替换 LeoaoApp 的 sso-token，并基于客户端原生 LKHS 算法联动重新生成 lk-safe1 与 lk-safe2 签名，防止换号报错
#!author=cdd
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Fitness.png
#!parm=leoao_sso_token

name: leoao_token_replace
desc: 自动替换 LeoaoApp 的 sso-token，并基于客户端原生 LKHS 算法联动重新生成 lk-safe1 与 lk-safe2 签名，防止换号报错

http:
  mitm:
    - "lens.leoao.com"
  script:
    - match: ^https:\/\/lens\.leoao\.com\/
      name: leoao_token_replace
      type: request
      require-body: true
      timeout: 10

script-providers:
  leoao_token_replace:
    url: https://raw.githubusercontent.com/cddchen/scripts/refs/heads/main/leoao-token.js
    interval: 86400
